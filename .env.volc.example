# Doubao 2.0 API Key: https://console.volcengine.com/speech/new/setting/apikeys
# Fill the private .env.volc file; process environment takes precedence.
VOLC_API_KEY=<YOUR_API_KEY>
VOLC_RESOURCE_ID=seed-tts-2.0

# Optional legacy console credentials, used only when API Key is empty.
VOLC_APPID=
VOLC_TOKEN=

# Authorized, English-capable Doubao 2.0 speaker IDs from the voice library.
# V3 uses speaker IDs, not Edge voice names or V1 voice_type settings.
VOLC_VOICE_GIRL=en_female_stokie_uranus_bigtts
VOLC_VOICE_BOY=ICL_uranus_en_male_kevin_mccallister_tob
VOLC_VOICE_DINO=en_male_michael-mouse_uranus_bigtts
VOLC_VOICE_TEACHER_F=en_female_wenrouzhishijieshuonv_uranus_bigtts
VOLC_VOICE_TEACHER_M=en_male_josh_coery_uranus_bigtts
VOLC_VOICE_NARRATOR=en_female_authoritative-british_uranus_bigtts
